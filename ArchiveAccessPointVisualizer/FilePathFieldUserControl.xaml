<UserControl x:Class="ArchiveAccessPointVisualizer.FilePathFieldUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ArchiveAccessPointVisualizer"
             mc:Ignorable="d"
             d:DesignHeight="30" d:DesignWidth="300">
    <Grid
        DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:FilePathFieldUserControl}}"
          >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Label 
            Content="{Binding Path=Label}"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Width="{Binding Path=LabelWidth}"
            Grid.Column="0"/>
        <TextBox 
            HorizontalAlignment="Stretch"
            Text="{Binding Path=Value}"
            Height="20"
            Margin="0,0,5,0"
            IsReadOnly="True"
            Grid.Column="1"/>
        <Button
            Content="{Binding Path=ButtonLabel}"
            Click="OnButtonClick"
            IsEnabled="{Binding Path=IsButtonEnabled}"
            Height="20"
            Width="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Grid.Column="2"/>
    </Grid>
</UserControl>
