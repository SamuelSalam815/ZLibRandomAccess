<Window x:Class="ArchiveAccessPointVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArchiveAccessPointVisualizer"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <ProgressBar Name="LogCompressionProgressBar" HorizontalAlignment="Left" Height="27" Margin="151,153,0,0" VerticalAlignment="Top" Width="309"/>
        <Button Name="CompressLogFileButton" Content="Write Log File" HorizontalAlignment="Left" Margin="64,152,0,0" VerticalAlignment="Top" Height="27" Width="82" Click="CompressLogFileButton_Click"/>
        <TextBox Name="LogSizeTargetTextBox" HorizontalAlignment="Left" Margin="149,111,0,0" TextWrapping="Wrap" Text="8" VerticalAlignment="Top" Width="120"/>
        <ComboBox Name="LogSizeUnitComboBox" HorizontalAlignment="Left" Margin="274,111,0,0" VerticalAlignment="Top" Width="48" Height="18" SelectedIndex="1">
            <ComboBoxItem Content="MB"/>
            <ComboBoxItem Content="GB"/>
        </ComboBox>
        <TextBlock HorizontalAlignment="Left" Height="20" Margin="64,110,0,0" TextWrapping="Wrap" Text="Log Size" VerticalAlignment="Top" Width="76"/>
        <CheckBox Content="CheckBox" HorizontalAlignment="Left" Height="15" Margin="64,132,0,0" VerticalAlignment="Top" Width="15"/>
        <TextBlock HorizontalAlignment="Left" Height="15" Margin="84,132,0,0" TextWrapping="Wrap" Text="Compress with random access points" VerticalAlignment="Top" Width="200"/>
        <Button Name="CancelButton" Content="❌" HorizontalAlignment="Left" Margin="471,156,0,0" VerticalAlignment="Top" Height="21" Width="21" IsEnabled="False" Click="CancelButton_Click"/>

    </Grid>
</Window>
