<Window x:Class="ArchiveAccessPointVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArchiveAccessPointVisualizer"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        >
    <Window.Resources>
        <local:LogFileCompressionRequestBuilderViewModel x:Key="Model"/>
    </Window.Resources>
    <Grid DataContext="{StaticResource Model}">
        <ProgressBar Name="LogCompressionProgressBar" HorizontalAlignment="Left" Height="27" Margin="101,189,0,0" VerticalAlignment="Top" Width="309"/>
        <Button Name="CompressLogFileButton" Content="Write Log File" HorizontalAlignment="Left" Margin="14,188,0,0" VerticalAlignment="Top" Height="27" Width="82" />
        <TextBox Name="LogSizeTargetTextBox" HorizontalAlignment="Left" Margin="102,167,0,0" TextWrapping="Wrap" Text="8" VerticalAlignment="Top" Width="47"/>
        <ComboBox
            Name="LogSizeUnitComboBox"
            HorizontalAlignment="Left"
            Margin="154,167,0,0"
            VerticalAlignment="Top"
            Width="42"
            Height="18"
            SelectedIndex="1"
            FontSize="10"
            SelectedItem="{Binding Path=SelectedUnitOfMeasure, Mode=OneWayToSource}"/>
        <TextBlock Height="20" Margin="17,166,707,0" TextWrapping="Wrap" Text="Log Size" VerticalAlignment="Top"/>
        <CheckBox
            Name="ShouldUseRecoveryPointCheckBox"
            Content="Compress using random access feature"
            HorizontalAlignment="Left" 
            Height="16"
            IsChecked="{Binding Path=ShouldUseRecoveryPoints}"
            Margin="98,130,0,0" VerticalAlignment="Top" Width="230"/>
        <Button Name="CancelButton" Content="❌" HorizontalAlignment="Left" Margin="421,192,0,0" VerticalAlignment="Top" Height="21" Width="21" IsEnabled="False" Click="CancelButton_Click" IsCancel="True"/>
        <TextBlock Name="CompressionJobStatusTextBlock" HorizontalAlignment="Left" Margin="14,220,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="396"/>
        <TextBlock Name="FormInputErrorTextBlock" HorizontalAlignment="Left" Height="161" Margin="443,32,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="258"/>
        <local:FilePathFieldUserControl
            Margin="7,32,368,366"
            Label="Output File"
            ButtonClick="SeekOutputFilePath"
            />
        <TextBox
            HorizontalAlignment="Left"
            Height="19"
            Margin="98,75,0,0"
            TextWrapping="Wrap"
            Text="{Binding Path=RecoveryPointFilePath, Mode=OneWay}"
            IsEnabled="{Binding Path=ShouldUseRecoveryPoints, Mode=OneWay}"
            VerticalAlignment="Top"
            Width="309"
            IsReadOnly="True" />
        <TextBlock Height="20" Margin="14,75,710,0" TextWrapping="Wrap" Text="Metadata File" VerticalAlignment="Top"/>
        <Button IsEnabled="{Binding Path=CanUserSpecifyRecoveryPointFilePath, Mode=OneWay}" Content="📂" HorizontalAlignment="Left" Margin="412,73,0,0" VerticalAlignment="Top"
                Click="SeekRecoveryPointFilePath"/>
        <CheckBox 
            IsEnabled="{Binding Path=ShouldUseRecoveryPoints, Mode=OneWay}"
            Content="Derive metadata file path from output file" HorizontalAlignment="Left" Height="15" Margin="98,105,0,0" VerticalAlignment="Top" Width="245"
            IsChecked="{Binding Path=ShouldDeriveRecoveryPointFilePath}"/>
        <local:FilePathFieldUserControl
            Margin="6,0,368,398"
            Label="Metadata file"
            ButtonClick="SeekRecoveryPointFilePath"
            Value="{Binding Path=RecoveryPointFilePath}"
            IsEnabled="{Binding Path=CanUserSpecifyRecoveryPointFilePath}"
            />

    </Grid>
</Window>
