<Window x:Class="ArchiveAccessPointVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArchiveAccessPointVisualizer"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <ProgressBar Name="LogCompressionProgressBar" HorizontalAlignment="Left" Height="27" Margin="97,44,0,0" VerticalAlignment="Top" Width="309"/>
        <Button Name="CompressLogFileButton" Content="Write Log File" HorizontalAlignment="Left" Margin="10,43,0,0" VerticalAlignment="Top" Height="27" Width="82" Click="CompressLogFileButton_Click"/>
        <TextBox Name="LogSizeTargetTextBox" HorizontalAlignment="Left" Margin="98,22,0,0" TextWrapping="Wrap" Text="8" VerticalAlignment="Top" Width="47"/>
        <ComboBox Name="LogSizeUnitComboBox" HorizontalAlignment="Left" Margin="150,22,0,0" VerticalAlignment="Top" Width="42" Height="18" SelectedIndex="1" FontSize="10">
            <ComboBoxItem Content="MB"/>
            <ComboBoxItem Content="GB"/>
        </ComboBox>
        <TextBlock HorizontalAlignment="Left" Height="20" Margin="13,21,0,0" TextWrapping="Wrap" Text="Log Size" VerticalAlignment="Top" Width="76"/>
        <CheckBox Content="CheckBox" HorizontalAlignment="Left" Height="15" Margin="198,23,0,0" VerticalAlignment="Top" Width="15"/>
        <TextBlock HorizontalAlignment="Left" Height="15" Margin="218,23,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="200"><Run Text="Compress with recovery "/><Run Text="points"/></TextBlock>
        <Button Name="CancelButton" Content="❌" HorizontalAlignment="Left" Margin="417,47,0,0" VerticalAlignment="Top" Height="21" Width="21" IsEnabled="False" Click="CancelButton_Click" IsCancel="True"/>
        <TextBlock Name="CompressionJobStatusTextBlock" HorizontalAlignment="Left" Margin="10,75,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="396"/>

    </Grid>
</Window>
